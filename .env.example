# ============================================================
# ASTRO — local environment (NEVER commit this file)
# ============================================================
APP_NAME_DEFAULT=ASTRO
APP_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# ---------- MySQL / MariaDB (XAMPP) ----------
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASS=
DB_NAME=kundlimilan
DB_SSL=false
DB_SSL_CA=
# Optional: connections per server instance (Vercel default 3) and the runtime auto-migration switch
DB_POOL=
DB_AUTO_MIGRATE=

# ---------- Security secrets (generated for this project, 256-bit) ----------
APP_HMAC_SECRET=
APP_LOCAL_DATA_KEY=

# ---------- AWS (S3 private files + KMS envelope encryption) ----------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
AWS_BUCKET_FOLDER=
AWS_KMS_KEY_ID=
# Customer files: <prefix><ASTRO ID>/reports/... → imoneytest/kundali/AST12345678/...
KM_S3_PREFIX=imoneytest/kundali/

# ---------- AstrologyAPI.com ----------
# JSON APIs (free tools) — wallet access token (x-astrologyapi-key)
ASTRO_ACCESS_TOKEN=
# PDF reports — subscription User ID + API key (HTTP Basic)
ASTRO_PDF_USER_ID=
ASTRO_PDF_API_KEY=

# ---------- Razorpay ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- ZeptoMail (OTP email) ----------
ZEPTO_MAIL_URL=
ZEPTO_MAIL=
ZEPTO_REGISTER_EMAIL_OTP=
ZEPTO_VERIFY_EMAIL_OTP=
ZEPTO_WELCOME_EMAIL_OTP=
ZEPTO_FROM_EMAIL=
ZEPTO_FROM_NAME=ASTRO

# ---------- Fast2SMS (OTP SMS) ----------
FAST_SMS_URL=
FAST2SMS=
FAST2SMS_ROUTE=dlt
FAST2SMS_SENDER_ID=
FAST2SMS_TEMPLATE_ID=

# ---------- Resend (report-ready emails) ----------
RESEND_API_KEY=
RESEND_FROM=ASTRO <onboarding@resend.dev>

# ---------- OTP / sessions ----------
OTP_TTL_SECONDS=300
OTP_DEV_ECHO=
OTP_DRY_RUN=
USER_SESSION_DAYS=180
ADMIN_SESSION_HOURS=12
ADMIN_IDLE_MINUTES=30

# ---------- Seed admin (npm run db:setup) ----------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
